:start
pln <h3>UrqW Tests</h3>
pln These are tests to ensure the UrqW engine is working correctly.
invkill
varkill
btn operators, Operators
btn constructs, System constructs
btn ui, User interface
end


:passed
passed = passed + 1
status = '<span style="color: #00aa00;">passed</span>'
end


:failed
failed = failed + 1
status = '<span style="color: #aa0000;">failed</span>'
end


:total
pln <h4>Total</h4>
pln Tests: #passed + failed$
pln Passed: #passed$
pln Failed: #failed$
end


:operators
pln <h3>Operators</h3>
pln These are automatic tests of programming language operators.
pln All tests must be passed (green).

pln <h4>URQL</h4>
x = 5
varkill
if x = 5 then proc failed else proc passed
pln varkill: #status$
x = 0
proc operators_goto
if x = 5 then proc passed else proc failed
pln goto: #status$
inv+ Item
if item = 1 then proc passed else proc failed
pln inv+ Item: #status$
inv+ 2, Item
if item = 3 then proc passed else proc failed
pln inv+ 2, Item: #status$
inv- Item
if item = 2 then proc passed else proc failed
pln inv- Item: #status$
inv- 3, Item
if item = 0 then proc passed else proc failed
pln inv- 3, Item: #status$
inv+ 5, Item
invkill
if item = 0 then proc passed else proc failed
pln invkill: #status$

pln <h4>Mathematical</h4>
x = 3
y = -3
pln Let x = #x$ and y = #y$
z = - x
if z = -3 then proc passed else proc failed
pln - x =##62$ -3: #status$
z = -x
if z = -3 then proc passed else proc failed
pln -x =##62$ -3: #status$
z = -(x+1)
if z = -4 then proc passed else proc failed
pln -(x+1) =##62$ -4: #status$
z =+y
if z = -3 then proc passed else proc failed
pln +y =##62$ -3: #status$
z = -y
if z = 3 then proc passed else proc failed
pln -y =##62$ 3: #status$
z = - (- y)
if z = -3 then proc passed else proc failed
pln - (- y) =##62$ -3: #status$
z = - y*2
if z = 6 then proc passed else proc failed
pln - y*2 =##62$ 6: #status$
z = 10 -y*2
if z = 16 then proc passed else proc failed
pln 10 -y*2 =##62$ 16: #status$
x = 1 + 2 +3+ 4+5
if x = 15 then proc passed else proc failed
pln 1 + 2 +3+ 4+5 =##62$ 15: #status$
x = 15 - 1 -2- 3-4
if x = 5 then proc passed else proc failed
pln 15 - 1 -2- 3-4 =##62$ 5: #status$
x = 2.5*4
if x = 10 then proc passed else proc failed
pln 2.5*4 =##62$ 10: #status$
x = 9/3
if x = 3 then proc passed else proc failed
pln 9/3 =##62$ 3: #status$
x = 2^3
if x = 8 then proc passed else proc failed
pln 2^3 =##62$ 8: #status$
x = -2^3
if x = -8 then proc passed else proc failed
pln -2^3 =##62$ -8: #status$
x = 2^3^2
if x = 512 then proc passed else proc failed
pln 2^3^2 =##62$ 512: #status$
x = 2*(2+2)^(3 - 1)
if x = 32 then proc passed else proc failed
pln 2*(2+2)^(3 - 1) =##62$ 32: #status$

pln <h4>Comparison</h4>
if 1<2 then proc passed else proc failed
pln 1##60$2 =##62$ true: #status$
if 1>2 then proc failed else proc passed
pln 1##62$2 =##62$ false: #status$
if 1<=2 then proc passed else proc failed
pln 1##60$=2 =##62$ true: #status$
if 2<=2 then proc passed else proc failed
pln 2##60$=2 =##62$ true: #status$
if 2<=1 then proc failed else proc passed
pln 2##60$=1 =##62$ false: #status$
if 2>=1 then proc passed else proc failed
pln 2##62$=1 =##62$ true: #status$
if 2>=2 then proc passed else proc failed
pln 2##62$=2 =##62$ true: #status$
if 1>=2 then proc failed else proc passed
pln 1##62$=2 =##62$ false: #status$
if 1<>2 then proc passed else proc failed
pln 1##60$##62$2 =##62$ true: #status$
if 2<>2 then proc failed else proc passed
pln 2##60$##62$2 =##62$ false: #status$
if 2!=2 then proc failed else proc passed
pln 2!=2 =##62$ false: #status$
if 2=2 then proc passed else proc failed
pln 2=2 =##62$ true: #status$
if 1 = 2 then proc failed else proc passed
pln 1 = 2 =##62$ false: #status$
if "abc"=="a?c" then proc passed else proc failed
pln "abc"=="a?c" =##62$ true: #status$
if "abc"=="a*" then proc passed else proc failed
pln "abc"=="a*" =##62$ true: #status$
if "abc"=="ABC" then proc faild else proc passed
pln "abc"=="ABC" =##62$ false: #status$

pln <h4>Logical</h4>
x = 1
y = 2
z = 3
pln Let x = #x$, y = #y$, and z = #z$
if x<y and z>y then proc passed else proc failed
pln x##60$y and z##62$y =##62$ true: #status$
if x<y&&z>y then proc passed else proc failed
pln x##60$y##38$##38$z##62$y =##62$ true: #status$
if x<y and y>z then proc failed else proc passed
pln x##60$y and y##62$z =##62$ false: #status$
if x<y&&y>z then proc failed else proc passed
pln x##60$y##38$##38$y##62$z =##62$ false: #status$
if x>y or z>y then proc passed else proc failed
pln x##62$y or z##62$y =##62$ true: #status$
if x>y||z>y then proc passed else proc failed
pln x##62$y##124$##124$z##62$y =##62$ true: #status$
if x>y or y>z then proc failed else proc passed
pln x##62$y or y##62$z =##62$ false: #status$
if x>y||y>z then proc failed else proc passed
pln x##62$y##124$##124$y##62$z =##62$ false: #status$
if not x then proc failed else proc passed
pln not x =##62$ false: #status$
if not unknown_variable then proc passed else proc failed
pln not unknown_variable =##62$ true: #status$
if not (not x) then proc passed else proc failed
pln not (not x) =##62$ true: #status$

pln <h4>Compound Assignment</h4>
a = 1
b = 2
c = 3
d = 4
pln Let a = #a$, b = #b$, c = #c$, and d = #d$
a+=3
if a = 4 then proc passed else proc failed
pln a+=3 =##62$ a = 4: #status$
b -=-1
if b = 3 then proc passed else proc failed
pln b -=-1 =##62$ b = 3: #status$
c*= 0.75
if c = 2.25 then proc passed else proc failed
pln c*= 0.75 =##62$ c = 2.25: #status$
d /= 4
if d = 1 then proc passed else proc failed
pln d /= 4 =##62$ d = 1: #status$
a /= b*(c+d) - 1.75
if a = 0.5 then proc passed else proc failed
pln a /= b*(c+d) - 1.75 =##62$ a = 0.5: #status$
c += "abc"
if c = "2.25abc" then proc passed else proc failed
pln c += "abc" =##62$ c = "2.25abc": #status$
if a = 0.5 then a += (d + 1.5)*b
if a = 8 then proc passed else proc failed
pln if a = 0.5 then a += (d + 1.5)*b =##62$ a = 8: #status$
if b = 2 then b += 0.5 else b -= b/0.5 -(d - 3.5)
if b = -5.5 then proc passed else proc failed
pln if b = 2 then b += 0.5 else b -= b/0.5 -(d - 3.5) =##62$ b = -5.5: #status$
x = "one" & x += " two"
if x = "one two" then proc passed else proc failed
pln x = "one" ##38$ x += " two" =##62$ x = "one two": #status$

proc total
btn start, Back
end


:operators_goto
x = x + 1
if x < 5 then goto operators_goto
end


:constructs
pln <h3>System Constructs</h3>
pln These are automatic tests of programming language system constructs.
pln All tests must be passed (green).
pln #/$
x = 123
y = "test"
pln Let x = #x$ and y = "#y$"

construct = "##35$x##36$"
result = 123
proc constructs_check
construct = "##35$y##36$"
result = "test"
proc constructs_check
construct = "##35$%x##36$"
result = 123
proc constructs_check
construct = "##35$%y##36$"
result = "test"
proc constructs_check
construct = "##35$##36$"
result = " "
proc constructs_check
construct = "##35$%##36$"
result = " "
proc constructs_check
construct = "##35$/##36$"
result = "<br>"
proc constructs_check
construct = "##35$%/##36$"
result = "<br>"
proc constructs_check
construct = "##35$##35$42##36$"
javascript = "new DOMParser().parseFromString('##38$##35$42;', 'text/html').body.textContent;"
result = javascript
proc constructs_check
construct = "##35$##35$8381##36$"
javascript = "new DOMParser().parseFromString('##38$##35$8381;', 'text/html').body.textContent;"
result = javascript
proc constructs_check

x = 1 & x = x + 1
if x = 2 then proc passed else proc failed
pln x = 1 ##38$ x = x + 1 =##62$ x = 2: #status$
x = 1 & x = x + 1 & x = x + 1 & x = x + 1
if x = 4 then proc passed else proc failed
pln x = 1 ##38$ x = x + 1 ##38$ x = x + 1 ##38$ x = x + 1 =##62$ x = 4: #status$
pln #/$
x = 1
/*
x = 2
*/
if x = 1 then proc passed else proc failed
pln x = 1
pln ##47$*
pln x = 2
pln *##47$ =##62$ x = 1: #status$
pln #/$
x = 1 + 2
	_ + 3
if x = 6 then proc passed else proc failed
pln x = 1 + 2
pln ##9$_ + 3 =##62$ x = 6: #status$

proc total
btn start, Back
end


:constructs_check
p #construct$:
javascript = "compareResults(Parser.prototype.openTags(new DOMParser().parseFromString('#construct$', 'text/html').body.textContent), '#result$');"
pln #$#status$
end


:ui
invkill
varkill
pln <h3>User Interface</h3>
pln These are non-automated tests of the player's user interface.
btn ui_anykey, anykey
btn ui_input, input
btn ui_quit, quit
btn start, Back
end


:ui_anykey
pln <h3>anykey</h3>
pln Press the Escape key
anykey x
pln You pressed the key with the code #x$.
if x = 27 then pln This is the Escape key code. else pln This is not the Escape key code.
btn ui, Back
end


:ui_input
pln <h3>input</h3>
pln Enter something:
input x
pln This is what you entered: #x$
btn ui, Back
end


:ui_quit
pln <h3>quit</h3>
pln If you don't see the Back choice button, the test has passed.
pln Use the Restart game icon in the toolbar.
quit
btn ui, Back
end
