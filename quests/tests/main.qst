:start
pln <h3>UrqW Tests</h3>
pln These are tests to ensure the UrqW engine is working correctly.
invkill
varkill
btn operators, Operators
btn functions, Functions
btn constructs, System constructs
btn ui, User interface
end


:passed
passed = passed + 1
status = '<span style="color: #00aa00;">passed</span>'
end


:failed
failed = failed + 1
status = '<span style="color: #aa0000;">failed</span>'
end


:total
pln <h4>Total</h4>
pln Tests: #passed + failed$
pln Passed: #passed$
pln Failed: #failed$
end


:operators
pln <h3>Operators</h3>
pln These are automatic tests of programming language operators.
pln All tests must be passed (green).

pln <h4>URQL</h4>
x = 5
y = 5
varkill
if x = 0 and y = 0 and urq_mode then proc passed else proc failed
pln varkill: #status$
x = 5
y = 5
varkill X
if x = 0 and y = 5 then proc passed else proc failed
pln varkill variable: #status$
x = 0
proc operators_goto
if x = 5 then proc passed else proc failed
pln goto: #status$
inv+ Item
if inv_item = 1 and item = 1 then proc passed else proc failed
pln inv+ Item: #status$
inv+ 2, Item
if inv_item = 3 and item = 3 then proc passed else proc failed
pln inv+ 2, Item: #status$
inv- Item
if inv_item = 2 and item = 2 then proc passed else proc failed
pln inv- Item: #status$
inv- 3, Item
if inv_item = 0 and item = 0 then proc passed else proc failed
pln inv- 3, Item: #status$
inv+ 2, Item2
inv+ 3, Item3
invkill IteM2
if inv_item2 = 0 and item2 = 0 and inv_item3 = 3 and item3 = 3 then proc passed else proc failed
pln invkill item: #status$
invkill
if inv_item3 = 0 and item3 = 0 then proc passed else proc failed
pln invkill: #status$
instr_leave_spc="test" & instr str = hello
if str = " hello" then proc passed else proc failed
pln instr_leave_spc="test" ##38$ instr str = hello =##62$ str = " hello": #status$
instr_leave_spc=1 & instr str = hello
if str = " hello" then proc passed else proc failed
pln instr_leave_spc=1 ##38$ instr str = hello =##62$ str = " hello": #status$
instr_leave_spc=-1 & instr str = hello
if str = " hello" then proc passed else proc failed
pln instr_leave_spc=-1 ##38$ instr str = hello =##62$ str = " hello": #status$
instr_leave_spc=0 & instr str = hello
if str = "hello" then proc passed else proc failed
pln instr_leave_spc=0 ##38$ instr str = hello =##62$ str = "hello": #status$

pln <h4>Mathematical</h4>
x = 3
y = -3
pln Let x = #x$ and y = #y$
z = - x
if z = -3 then proc passed else proc failed
pln - x =##62$ -3: #status$
z = -x
if z = -3 then proc passed else proc failed
pln -x =##62$ -3: #status$
z = -(x+1)
if z = -4 then proc passed else proc failed
pln -(x+1) =##62$ -4: #status$
z =+y
if z = -3 then proc passed else proc failed
pln +y =##62$ -3: #status$
z = -y
if z = 3 then proc passed else proc failed
pln -y =##62$ 3: #status$
z = - (- y)
if z = -3 then proc passed else proc failed
pln - (- y) =##62$ -3: #status$
z = - y*2
if z = 6 then proc passed else proc failed
pln - y*2 =##62$ 6: #status$
z = 10 -y*2
if z = 16 then proc passed else proc failed
pln 10 -y*2 =##62$ 16: #status$
x = 1 + 2 +3+ 4+5
if x = 15 then proc passed else proc failed
pln 1 + 2 +3+ 4+5 =##62$ 15: #status$
x = 15 - 1 -2- 3-4
if x = 5 then proc passed else proc failed
pln 15 - 1 -2- 3-4 =##62$ 5: #status$
x = 2.5*4
if x = 10 then proc passed else proc failed
pln 2.5*4 =##62$ 10: #status$
x = 9/3
if x = 3 then proc passed else proc failed
pln 9/3 =##62$ 3: #status$
x = 2^3
if x = 8 then proc passed else proc failed
pln 2^3 =##62$ 8: #status$
x = -2^3
if x = -8 then proc passed else proc failed
pln -2^3 =##62$ -8: #status$
x = 2^3^2
if x = 512 then proc passed else proc failed
pln 2^3^2 =##62$ 512: #status$
x = 2*(2+2)^(3 - 1)
if x = 32 then proc passed else proc failed
pln 2*(2+2)^(3 - 1) =##62$ 32: #status$

pln <h4>Comparison</h4>
if 1<2 then proc passed else proc failed
pln 1##60$2 =##62$ true: #status$
if 1>2 then proc failed else proc passed
pln 1##62$2 =##62$ false: #status$
if 1<=2 then proc passed else proc failed
pln 1##60$=2 =##62$ true: #status$
if 2<=2 then proc passed else proc failed
pln 2##60$=2 =##62$ true: #status$
if 2<=1 then proc failed else proc passed
pln 2##60$=1 =##62$ false: #status$
if 2>=1 then proc passed else proc failed
pln 2##62$=1 =##62$ true: #status$
if 2>=2 then proc passed else proc failed
pln 2##62$=2 =##62$ true: #status$
if 1>=2 then proc failed else proc passed
pln 1##62$=2 =##62$ false: #status$
if 1<>2 then proc passed else proc failed
pln 1##60$##62$2 =##62$ true: #status$
if 2<>2 then proc failed else proc passed
pln 2##60$##62$2 =##62$ false: #status$
if 2!=2 then proc failed else proc passed
pln 2!=2 =##62$ false: #status$
if 2=2 then proc passed else proc failed
pln 2=2 =##62$ true: #status$
if 1 = 2 then proc failed else proc passed
pln 1 = 2 =##62$ false: #status$
if "abc"=="a?c" then proc passed else proc failed
pln "abc"=="a?c" =##62$ true: #status$
if "abc"=="a*" then proc passed else proc failed
pln "abc"=="a*" =##62$ true: #status$
if "abc"=="ABC" then proc passed else proc failed
pln "abc"=="ABC" =##62$ true: #status$

pln <h4>Logical</h4>
x = 1
y = 2
z = 3
pln Let x = #x$, y = #y$, and z = #z$
if x<y and z>y then proc passed else proc failed
pln x##60$y and z##62$y =##62$ true: #status$
if x<y&&z>y then proc passed else proc failed
pln x##60$y##38$##38$z##62$y =##62$ true: #status$
if x<y and y>z then proc failed else proc passed
pln x##60$y and y##62$z =##62$ false: #status$
if x<y&&y>z then proc failed else proc passed
pln x##60$y##38$##38$y##62$z =##62$ false: #status$
if x>y or z>y then proc passed else proc failed
pln x##62$y or z##62$y =##62$ true: #status$
if x>y||z>y then proc passed else proc failed
pln x##62$y##124$##124$z##62$y =##62$ true: #status$
if x>y or y>z then proc failed else proc passed
pln x##62$y or y##62$z =##62$ false: #status$
if x>y||y>z then proc failed else proc passed
pln x##62$y##124$##124$y##62$z =##62$ false: #status$
if not x then proc failed else proc passed
pln not x =##62$ false: #status$
if not unknown_variable then proc passed else proc failed
pln not unknown_variable =##62$ true: #status$
if not (not x) then proc passed else proc failed
pln not (not x) =##62$ true: #status$

pln <h4>Conditional</h4>
x = 1
y = 2
z = 3
pln Let x = #x$, y = #y$, and z = #z$
if -(x + y)*2 - z > -4*z then res = 1
if res = 1 then proc passed else proc failed
pln if -(x + y)*2 - z > -4*z then res = 1 =##62$ res = 1: #status$
if x then res = 2
if res = 2 then proc passed else proc failed
pln if x then res = 2 =##62$ res = 2: #status$
if not x then res = 0 else res = 3
if res = 3 then proc passed else proc failed
pln if not x then res = 0 else res = 3 =##62$ res = 3: #status$
if (not x) then res =  else res = 4
if res = 4 then proc passed else proc failed
pln if (not x) then res =  else res = 4 =##62$ res = 4: #status$
if not (x+y-z) then res = 5
if res = 5 then proc passed else proc failed
pln if not (x+y-z) then res = 5 =##62$ res = 5: #status$
if (not (x+y-z)) then res = 6
if res = 6 then proc passed else proc failed
pln if (not (x+y-z)) then res = 6 =##62$ res = 6: #status$
if not (x+y-z*2) then res = 0 else res = 7
if res = 7 then proc passed else proc failed
pln if not (x+y-z*2) then res = 0 else res = 7 =##62$ res = 7: #status$
if (not (x+y-z*2)) then res = 0 else res = 8
if res = 8 then proc passed else proc failed
pln if (not (x+y-z*2)) then res = 0 else res = 8 =##62$ res = 8: #status$
if x = 2 then y = 1 & z = 1 else res = 9
if y = 2 and z = 3 and res = 9 then proc passed else proc failed
pln if x = 2 then y = 1 ##38$ z = 1 else res = 9 =##62$ y = 2, z = 3, res = 9: #status$
if x = 1 then res = 10 else y = 1 & z = 1
if y = 2 and z = 3 and res = 10 then proc passed else proc failed
pln if x = 1 then res = 10 else y = 1 ##38$ z = 1 =##62$ y = 2, z = 3, res = 10: #status$
if '' then res = 0 else res = 11
if res = 11 then proc passed else proc failed
pln if '' then res = 0 else res = 11 =##62$ res = 11: #status$
if 'x' then res = 12 else res = 0
if res = 12 then proc passed else proc failed
pln if 'x' then res = 12 else res = 0 =##62$ res = 12: #status$
if '' or x = 1 then res = 13
if res = 13 then proc passed else proc failed
pln if '' or x = 1 then res = 13 =##62$ res = 13: #status$
if '' or x = 0 then res = 0 else res = 14
if res = 14 then proc passed else proc failed
pln if '' or x = 0 then res = 0 else res = 14 =##62$ res = 14: #status$
if x = 1 and 'x' then res = 15
if res = 15 then proc passed else proc failed
pln if x = 1 and 'x' then res = 15 =##62$ res = 15: #status$
if not '' then res = 16
if res = 16 then proc passed else proc failed
pln if not '' then res = 16 =##62$ res = 16: #status$
if not 'x' then res = 0 else res = 17
if res = 17 then proc passed else proc failed
pln if not 'x' then res = 0 else res = 17 =##62$ res = 17: #status$
if -5 then res = 18
if res = 18 then proc passed else proc failed
pln if -5 then res = 18 =##62$ res = 18: #status$
if '-5' then res = 19
if res = 19 then proc passed else proc failed
pln if '-5' then res = 19 =##62$ res = 19: #status$

pln <h4>Compound Assignment</h4>
a = 1
b = 2
c = 3
d = 4
pln Let a = #a$, b = #b$, c = #c$, and d = #d$
a+=3
if a = 4 then proc passed else proc failed
pln a+=3 =##62$ a = 4: #status$
b -=-1
if b = 3 then proc passed else proc failed
pln b -=-1 =##62$ b = 3: #status$
c*= 0.75
if c = 2.25 then proc passed else proc failed
pln c*= 0.75 =##62$ c = 2.25: #status$
d /= 4
if d = 1 then proc passed else proc failed
pln d /= 4 =##62$ d = 1: #status$
a /= b*(c+d) - 1.75
if a = 0.5 then proc passed else proc failed
pln a /= b*(c+d) - 1.75 =##62$ a = 0.5: #status$
c += "abc"
if c = "2.25abc" then proc passed else proc failed
pln c += "abc" =##62$ c = "2.25abc": #status$
if a = 0.5 then a += (d + 1.5)*b
if a = 8 then proc passed else proc failed
pln if a = 0.5 then a += (d + 1.5)*b =##62$ a = 8: #status$
if b = 2 then b += 0.5 else b -= b/0.5 -(d - 3.5)
if b = -5.5 then proc passed else proc failed
pln if b = 2 then b += 0.5 else b -= b/0.5 -(d - 3.5) =##62$ b = -5.5: #status$
x = "one" & x += " two"
if x = "one two" then proc passed else proc failed
pln x = "one" ##38$ x += " two" =##62$ x = "one two": #status$

proc total
btn start, Back
end


:operators_goto
x = x + 1
if x < 5 then goto operators_goto
end


:functions
pln <h3>Functions</h3>
pln These are automatic tests of programming language built-in functions.
pln All tests must be passed (green).

pln <h4>Mathematical</h4>
if Abs(-5) = 5 then proc passed else proc failed
pln Abs(-5) =##62$ 5: #status$
if Ceil(2) = 2 then proc passed else proc failed
pln Ceil(2) =##62$ 2: #status$
if Ceil(2.1) = 3 then proc passed else proc failed
pln Ceil(2.1) =##62$ 3: #status$
if Exp(0) = 1 then proc passed else proc failed
pln Exp(0) =##62$ 1: #status$
if Floor(2) = 2 then proc passed else proc failed
pln Floor(2) =##62$ 2: #status$
if Floor(2.9) = 2 then proc passed else proc failed
pln Floor(2.9) =##62$ 2: #status$
if Int(2.3) = 2 then proc passed else proc failed
pln Int(2.3) =##62$ 2: #status$
if Invert(0) = 1 then proc passed else proc failed
pln Invert(0) =##62$ 1: #status$
if Invert(1) = 0 then proc passed else proc failed
pln Invert(1) =##62$ 0: #status$
if Invert("hello") = 0 then proc passed else proc failed
pln Invert("hello") =##62$ 0: #status$
if Invert("") = 1 then proc passed else proc failed
pln Invert("") =##62$ 1: #status$
if Invert(5) = 0 then proc passed else proc failed
pln Invert(5) =##62$ 0: #status$
if Invert(-5) = 0 then proc passed else proc failed
pln Invert(-5) =##62$ 0: #status$
if Log(1) = 0 and not error then proc passed else proc failed
pln Log(1) =##62$ 0: #status$
if Log(Exp(3)) = 3 then proc passed else proc failed
pln Log(Exp(3)) =##62$ 3: #status$
if Log10(100) = 2 then proc passed else proc failed
pln Log10(100) =##62$ 2: #status$
if Log2(8) = 3 then proc passed else proc failed
pln Log2(8) =##62$ 3: #status$
if Max(1,2 ,3, 4 , 5) = 5 then proc passed else proc failed
pln Max(1,2 ,3, 4 , 5) =##62$ 5: #status$
if Min(1, 2, -3, 4, 5) = -3 then proc passed else proc failed
pln Min(1, 2, -3, 4, 5) =##62$ -3: #status$
if Pow(3, 4) = 81 then proc passed else proc failed
pln Pow(3, 4) =##62$ 81: #status$
if Round(2.5) = 3 then proc passed else proc failed
pln Round(2.5) =##62$ 3: #status$
if Round(2.125, 2) = 2.13 then proc passed else proc failed
pln Round(2.125, 2) =##62$ 2.13: #status$
if Sqrt(144) = 12 then proc passed else proc failed
pln Sqrt(144) =##62$ 12: #status$

pln <h4>Checking</h4>
declared_variable = 1
pln let declared_variable = #declared_variable$
if IsArray('[1, "two"]') = 1 then proc passed else proc failed
pln IsArray('[1, "two"]') =##62$ 1: #status$
if IsBoolean(1) then proc passed else proc failed
pln IsBoolean(1) =##62$ 1: #status$
if IsBoolean("1") = 0 and not error then proc passed else proc failed
pln IsBoolean("1") =##62$ 0: #status$
if IsDeclared("declared_variable") = 1 then proc passed else proc failed
pln IsDeclared("declared_variable") =##62$ 1: #status$
if IsDeclared("  DeClArEd_VaRiAbLe  ") = 1 then proc passed else proc failed
pln IsDeclared("  DeClArEd_VaRiAbLe  ") =##62$ 1: #status$
if IsDeclared("undeclared variable") = 0 and not error then proc passed else proc failed
pln IsDeclared("undeclared_variable") =##62$ 0: #status$
if IsNumber(12.3) = 1 then proc passed else proc failed
pln IsNumber(12.3) =##62$ 1: #status$
if IsNumber("1") = 0 and not error then proc passed else proc failed
pln IsNumber("1") =##62$ 0: #status$
if IsNumber(1 + "1") = 0 and not error then proc passed else proc failed
pln IsNumber(1 + "1") =##62$ 0: #status$
if IsObject('{"one": 1}') = 1 then proc passed else proc failed
pln IsObject('{"one": 1}') =##62$ 1: #status$
if IsObject('[1, "two"]') = 0 and not error then proc passed else proc failed
pln IsObject('[1, "two"]') =##62$ 0: #status$
if IsString("abc") = 1 then proc passed else proc failed
pln IsString("abc") =##62$ 1: #status$
if IsString(1 + "1") = 1 then proc passed else proc failed
pln IsString(1 + "1") =##62$ 1: #status$

pln <h4>Expressions with Functions</h4>
a = 1
b = 2
c = 3
pln Let a = #a$, b = #b$, and c = #c$
x = a - Sqrt(352 / (Abs(b^2 - c*10) - Log10(81)/Log10(c)))
if x = -3 then proc passed else proc failed
pln a - Sqrt(352 / (Abs(b^2 - c*10) - Log10(81)/Log10(c))) =##62$ -3: #status$
if Pow(b, c) > Max(a, b, c) then proc passed else proc failed
pln Pow(b, c) > Max(a, b, c) =##62$ true: #status$

proc total
btn start, Back
end


:constructs
pln <h3>System Constructs</h3>
pln These are automatic tests of programming language system constructs.
pln All tests must be passed (green).
pln #/$
x = 123
y = "test"
pln Let x = #x$ and y = "#y$"

construct = "##35$x##36$"
result = 123
proc constructs_check
construct = "##35$y##36$"
result = "test"
proc constructs_check
construct = "##35$%x##36$"
result = 123
proc constructs_check
construct = "##35$%y##36$"
result = "test"
proc constructs_check
construct = "##35$##36$"
result = " "
proc constructs_check
construct = "##35$%##36$"
result = " "
proc constructs_check
construct = "##35$/##36$"
result = "<br>"
proc constructs_check
construct = "##35$%/##36$"
result = "<br>"
proc constructs_check
construct = "##35$##35$42##36$"
javascript = "new DOMParser().parseFromString('##38$##35$42;', 'text/html').body.textContent;"
result = javascript
proc constructs_check
construct = "##35$##35$8381##36$"
javascript = "new DOMParser().parseFromString('##38$##35$8381;', 'text/html').body.textContent;"
result = javascript
proc constructs_check

x = 1 & x = x + 1
if x = 2 then proc passed else proc failed
pln x = 1 ##38$ x = x + 1 =##62$ x = 2: #status$
x = 1 & x = x + 1 & x = x + 1 & x = x + 1
if x = 4 then proc passed else proc failed
pln x = 1 ##38$ x = x + 1 ##38$ x = x + 1 ##38$ x = x + 1 =##62$ x = 4: #status$
pln #/$
x = 1
/*
x = 2
*/
if x = 1 then proc passed else proc failed
pln x = 1
pln ##47$*
pln x = 2
pln *##47$ =##62$ x = 1: #status$
pln #/$
x = 1 + 2
	_ + 3
if x = 6 then proc passed else proc failed
pln x = 1 + 2
pln ##9$_ + 3 =##62$ x = 6: #status$

proc total
btn start, Back
end


:constructs_check
p #construct$:
javascript = "compareResults(Parser.prototype.openTags(new DOMParser().parseFromString('#construct$', 'text/html').body.textContent), '#result$');"
pln #$#status$
end


:ui
invkill
varkill
pln <h3>User Interface</h3>
pln These are non-automated tests of the player's user interface.
btn ui_anykey, anykey
btn ui_input, input
btn ui_inv, Inventory
btn ui_quit, quit
btn start, Back
end


:ui_anykey
pln <h3>anykey</h3>
pln Press the Escape key
anykey x
pln You pressed the key with the code #x$.
if x = 27 then pln This is the Escape key code. else pln This is not the Escape key code.
btn ui, Back
end


:ui_input
pln <h3>input</h3>
pln Enter something:
input x
pln This is what you entered: #x$
btn ui, Back
end


:ui_inv
invkill
varkill
pln Action: Open the inventory panel.
pln Result: Inventory is empty (the "[empty]" text depends on the UrqW interface language).
btn ui_inv_non_clickable, Non-clickable item
btn ui_inv_clickable, Clickable item
btn ui_inv_multiple, Multiple item
btn ui_inv_actions, Item with actions
btn ui, Back
end


:ui_inv_non_clickable
if count_#current_loc$ = 1 then proc ui_inv_non_clickable_prep
pln Action 1: Open the inventory panel.
pln Result 1: There are 2 items in the inventory: a copper coin and a wallet (in exactly that order).
pln Action 2: Focus (pointer or keyboard) on any item and press on it.
pln Result 2: When pressing the item, nothing happens (the item has the aria-disabled attribute, and screen readers describe it as not interactable).
pln Action 3: Press the Drop a copper coin button.
pln Result 3: There is 1 item in the inventory: a wallet.
pln Action 4: Press the Take a copper coin button.
pln Result 4: There are 2 items in the inventory: a wallet and a copper coin (in exactly that order).
if inv_coin1 then btn invkill coin1 & cls & goto #current_loc$, Drop a copper coin
if not inv_coin1 then btn inv+ coin1 & cls & goto #current_loc$, Take a copper coin
btn ui_inv, Back
end


:ui_inv_non_clickable_prep
display_use_coin1 = "Copper coin"
inv+ coin1
inv+ wallet
end


:ui_inv_clickable
if count_#current_loc$ = 1 then proc ui_inv_clickable_prep
pln Action 1: Open the inventory panel.
pln Result 1: There is 1 item in the inventory: a silver coin.
pln Action 2: Focus (pointer or keyboard) on the item and press on it several times.
pln Result 2: After each pressing on the item, text with its description is added below.
btn ui_inv, Back
end


:ui_inv_clickable_prep
display_use_coin2 = "Silver coin"
inv+ coin2
end


:use_coin2
pln This is a silver coin.
end


:ui_inv_multiple
if count_#current_loc$ = 1 then proc ui_inv_multiple_pref
pln Action 1: Open the inventory panel.
pln Result 1: There is 1 item in the inventory: a gold coin (5 pieces).
pln Action 2: Press the Drop 3 gold coins button 2 times.
pln Result 2: After the first pressing, 2 gold coins remain in the inventory, after the second the inventory is empty.
pln Action 3: Press the Take a gold coin button 1 time.
pln Result 3: There is 1 item in the inventory: a gold coin (without specifying the quantity in brackets).
if inv_coin3 then btn inv_coin3 -= 3 & cls & goto #current_loc$, Drop 3 gold coins
if inv_coin3 < 5 then btn inv_coin3 += 1 & cls & goto #current_loc$, Take a gold coin
btn ui_inv, Back
end


:ui_inv_multiple_pref
display_use_coin3 = "Gold coin"
inv+ 5, coin3
end


:ui_inv_actions
if count_#current_loc$ = 1 then proc ui_inv_actions_pref
pln Action 1: Open the inventory panel.
pln Result 1: There are 2 items in the inventory: an eraser and a dull coin.
pln Action 2: Focus (pointer or keyboard) on all items and press on them one after the other.
pln Result 2: When pressing the items, nothing happens (all items have the aria-disabled attribute, and screen readers describe them as not interactable).
pln Action 3: Press the Make inventory interactable button and focus on the dull coin item.
pln Result 3: A drop-down menu with 3 actions appeared: examine (depends on the UrqW interface language), bite to test and polish to a shine.
pln Action 4: Press the polish to a shine action in the item's action drop-down menu.
pln Result 4: There are 2 items in the inventory: an eraser and a shiny coin.
pln Action 5: Focus on the shiny coin item.
pln Result 5: A drop-down menu with 2 actions appeared: examine (depends on the UrqW interface language) and bite to test.
pln Action 6: Press the Make the coin not interactable button, focus on the shiny coin item again and press it.
pln Result 6: When focusing and pressing the item, nothing happens (the item has the aria-disabled attribute, and screen readers describe it as not interactable).
if hide_use then btn hide_use = 0 & cls & goto #current_loc$, Make inventory interactable
if not hide_use and not hide_use_coin4 then btn hide_use_coin4 = 1 & cls & goto #current_loc$, Make the coin not interactable
btn ui_inv, Back
end


:ui_inv_actions_pref
hide_use = 1
display_use_eraser_polish = "polish a coin"
inv+ eraser
display_use_coin4 = "Dull coin"
display_use_coin4_bite = "bite to test"
display_use_coin4_polish = "polish to a shine"
inv+ coin4
end


:use_eraser
p This is an eraser
if hide_use_coin4_polish then pln . else pln #$that can be used to polish a coin.
end


:use_eraser_polish
proc use_coin4_polish
end


:use_coin4
if hide_use_coin4_polish then coin_state = "shiny" else coin_state = "dull"
pln This is a #coin_state$ coin.
end


:use_coin4_bite
pln Dentists don't approve of this.
end


:use_coin4_polish
display_use_coin4 = "Shiny coin"
hide_use_coin4_polish = 1
hide_use_eraser_polish = 1
pln Swish-swish...
end


:ui_quit
pln <h3>quit</h3>
pln If you don't see the Back choice button, the test has passed.
pln Use the Restart game icon in the toolbar.
quit
btn ui, Back
end
